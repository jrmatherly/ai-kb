# Ignore all hidden files and directories
.*
# But keep specific hidden files and directories
!.env.example
!.gitignore
!.gitkeep
!.markdownlint-cli2.jsonc
!.shellcheckrc
!.npmrc
!docreader/.python-version
!.github/

# Sensitive files
*.pem
*_key
*_secret
*.key
*.crt

# IDE and editor files
*.swp
*.swo

# Build and dependency files
node_modules/
/dist/
/build/
*.log

# Temporary files
tmp/
temp/
logs/
*.pid

ai-kb
ai-kb-lite
cmd/desktop/build/bin/
cmd/desktop/build/windows/installer/bundle/
/models/
test/data/mswag.txt
data/files/
data/aikb.db
data/aikb.db-wal
data/aikb.db-shm
skills-lock.json

web/

**/__pycache__
/scripts/scale_dev_jobs.sh
/server
frontend/.vite
frontend/chrome-extension/
WeKnora-Chrome-Extension


# Local test scripts
configure-ollama.sh
fix-docker.sh

# WeChat Mini Program local/private configuration
miniprogram/project.private.config.json

# Staging dir for the Docker sandbox self-check probe (removed after each run)
.ai-kb-sandbox-check-*

# Locally built BrowserSkill runtime and extension bundles
/artifacts/browserskill/

.codegraph/
.remember/
private/

# Tooling tracked in this copy (the `.*` rule above hides dotfiles by default)
!.claude/
.claude/settings.local.json
!.upstream-review/
!.serena/
.claude/worktrees/

# setuptools build metadata, regenerated by every mcp-server build
*.egg-info/
mcp-server/build/
# Wails desktop build writes this to decide whether to re-run npm install
frontend/package.json.md5
