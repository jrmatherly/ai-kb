# VCS / CI
.git/
.github/
.gitignore
.gitattributes

# Editor / IDE local settings
.cursor/
.claude/
.codebuddy/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python virtual environments / caches
**/.venv/
.venv_proto/
**/.python-version
**/__pycache__/
**/*.pyc

# Node / frontend
# Note: build-ui uses ./frontend as its context, so the root .dockerignore does not apply to it.
# The Dockerfiles of the other images (app/docreader/sandbox) do not reference frontend/,
# so the whole frontend/ directory can be excluded here.
**/node_modules/
frontend/
WeKnora-Chrome-Extension/

# Logs / temporary files
logs/
tmp/
temp/
*.log
*.pid

# Local build output / binaries
ai-kb
ai-kb-lite
/server
/dist/
/build/
/artifacts/browserskill/
cmd/desktop/build/bin/

# Local data / model files
/models/
data/files/
data/*.db
data/*.db-wal
data/*.db-shm
test/data/mswag.txt

# Sensitive files
.env
.env.lite
*.pem
*.key
*.crt
*_key
*_secret

# Large archives / compressed files
packages/protoc-*.zip
!packages/protoc-*-linux-x86_64.zip
!packages/protoc-*-linux-aarch_64.zip
!packages/protoc-*-linux-arm.zip

# Local test scripts
configure-ollama.sh
fix-docker.sh
/scripts/scale_dev_jobs.sh

# Note: do not exclude docs/. Its docs.go / swagger.json form the swagger package the Go code depends on
# Note: do not exclude with a *.md wildcard. skills/preloaded/**/SKILL.md is packed into the image for the agent
