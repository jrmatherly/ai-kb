#!/usr/bin/env bash
# Fast checks on staged files (PR checklist + gofmt). Mirrors app.yml formatting gate.

set -euo pipefail

# The work tree the hook runs for (git starts hooks there), not the hook file's own checkout:
# core.hooksPath may name another worktree's scripts.
ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=common.sh
source "$ROOT/scripts/git-hooks/common.sh"

if hook_skip; then
  exit 0
fi

cd "$ROOT"

log_step "pre-commit"

check_whitespace --cached

# English-only copy: block CJK text in added lines (scripts/check-english-only.sh --diff).
"$ROOT/scripts/check-english-only.sh" --diff

# No em dashes outside scripts/emdash-allowlist.txt (scripts/check-emdash.sh).
"$ROOT/scripts/check-emdash.sh" --cached

staged_go=()
while IFS= read -r line; do
  [[ -n "$line" ]] && staged_go+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.go' ':!cli/**' || true)

if [[ ${#staged_go[@]} -gt 0 ]]; then
  go_files=()
  for f in "${staged_go[@]}"; do
    go_files+=("$ROOT/$f")
  done
  check_gofmt_files write "${go_files[@]}"

  if command -v golangci-lint >/dev/null 2>&1; then
    # Lint only what differs from HEAD (staged + unstaged in those packages).
    run_golangci_if_available HEAD
  fi
fi

# Lints the working-tree file, like gofmt above. Never --fix here: some fixers damage content (MD018, MD029,
# MD037, MD038). The config's ignores still apply to named files, so the changelogs need no filter.
staged_md=()
while IFS= read -r line; do
  [[ -n "$line" ]] && staged_md+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md' || true)

if [[ ${#staged_md[@]} -gt 0 ]]; then
  if command -v npx >/dev/null 2>&1; then
    log_step "markdownlint (${#staged_md[@]} staged Markdown file(s))"
    npx --yes "$MARKDOWNLINT_CLI2" --no-globs -- "${staged_md[@]}"
    log_ok "markdownlint"
  else
    log_step "npx not installed; skip markdownlint"
  fi
fi

log_ok "pre-commit passed"
