#!/usr/bin/env bash
# Pre-push: whitespace on the pushed commits, then scripts/validate.sh (this copy's CI) on everything
# since the push base.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=common.sh
source "$ROOT/scripts/git-hooks/common.sh"

if hook_skip; then
  exit 0
fi

cd "$ROOT"

remote="${1:-origin}"
head="$(git rev-parse HEAD)"
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  log_step "pre-push ($remote ${remote_ref#refs/heads/})"
  if [[ "$remote_sha" == "$local_sha" ]]; then
    log_ok "pre-push: nothing new to push"
    continue
  fi
  if [[ "$local_sha" != "$head" ]]; then
    log_fail "pushing ${local_sha:0:12}, which is not HEAD: validate.sh checks the working tree, so check it out and push again (SKIP_HOOKS=1 skips the hooks)"
    exit 1
  fi

  base="$(git merge-base "$(pr_diff_base_ref)" "$local_sha")"
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    check_whitespace "${base}..${local_sha}"
  else
    check_whitespace "${remote_sha}..${local_sha}"
  fi
  # stdin carries the remaining refs; keep the checks from reading it.
  "$ROOT/scripts/validate.sh" --base "$base" </dev/null
  log_ok "pre-push passed"
done

exit 0
