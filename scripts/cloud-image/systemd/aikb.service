[Unit]
Description=AI KB (docker compose)
Requires=docker.service ai-kb-firstboot.service
After=docker.service network-online.target ai-kb-firstboot.service
Wants=network-online.target
# Key point: Requires=ai-kb-firstboot.service keeps this service from starting when first-boot init fails,
# so the postgres data volume is never initialized with the plaintext default passwords from .env.example
# before firstboot has generated random keys. On an already initialized instance, ai-kb-firstboot.service is
# skipped by ConditionPathExists=!/opt/ai-kb/.firstboot.done, and a skip counts as success,
# so it does not block later restarts of this service.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-kb
ExecStart=@DOCKER_BIN@ compose up -d
ExecStop=@DOCKER_BIN@ compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
