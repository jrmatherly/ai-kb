{
  "name": "ai-kb-docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm --prefix homepage ci",
    "dev": "node scripts/serve-site.mjs",
    "dev:docs": "vitepress dev",
    "dev:homepage": "npm --prefix homepage run dev",
    "build": "node scripts/build-site.mjs",
    "build:docs": "vitepress build",
    "build:homepage": "npm --prefix homepage run build",
    "preview": "node scripts/serve-site.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:docs": "npm run check:links && npm run check:mermaid",
    "check:site": "node scripts/check-site.mjs",
    "check": "npm run check:docs && npm run check:site",
    "package:site": "node scripts/package-site.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:docker": "node scripts/test-docker.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "mermaid": "12.2.0",
    "playwright-core": "1.64.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44"
  },
  "version": "2026.10.18.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "vite": "^6.4.3",
    "vitepress-plugin-mermaid": {
      "mermaid": "$mermaid"
    }
  }
}
