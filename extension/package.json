{
  "name": "ai-kb-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.scripts.config.ts --mode background && vite build -c vite.scripts.config.ts --mode content && node scripts/check-manifest.mjs dist/manifest.json",
    "type-check": "vue-tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "defuddle": "0.19.5",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
