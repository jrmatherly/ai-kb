# AI KB Lite configuration template
# Copy this file to .env.lite and edit as needed
#   cp .env.lite.example .env.lite

GIN_MODE=debug

# Log level: debug, info, warn, error, fatal
LOG_LEVEL=debug

# Optional: absolute log file path. When unset, the macOS .app writes to
# ~/Library/Logs/AI KB Lite/AI KB Lite.log
# LOG_PATH=/absolute/path/to/ai-kb-lite.log

# === Database ===
# In the macOS .app, relative paths are redirected to
# ~/Library/Application Support/AI KB Lite/data/
DB_DRIVER=sqlite
DB_PATH=./data/aikb.db

# === Retrieval engine (FTS5 + sqlite-vec) ===
RETRIEVE_DRIVER=sqlite

# === File storage ===
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# === Stream management (in memory, no Redis) ===
STREAM_MANAGER_TYPE=memory

# === LLM service ===
# Local Ollama service (default address, change as needed).
# Embedding and chat models with source=local share this address. No second Ollama is needed for embeddings.
# The embedding model name is set in the model configuration (for example nomic-embed-text), not in an env variable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# To use another OpenAI-compatible service, uncomment:
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Security (replace the defaults before storing real credentials) ===
# The server refuses to start when either is empty or SYSTEM_AES_KEY is not exactly 32 bytes; it warns while the
# shipped defaults below are in use. Generate once: openssl rand -hex 16 (SYSTEM_AES_KEY), openssl rand -hex 32 (JWT_SECRET).
# The default JWT_SECRET never signs: a per-install secret stored in the database is used instead.
# The native desktop app replaces both defaults with keys it generates and persists itself.
SYSTEM_AES_KEY=aikb-default-aes-key-change-me!!
JWT_SECRET=aikb-default-jwt-secret-change-me

# === Feature flags ===
NEO4J_ENABLE=false
AIKB_SANDBOX_MODE=disabled
ENABLE_GRAPH_RAG=false
DISABLE_REGISTRATION=false
# Image host allowlist whose original URLs are kept (optional)
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# === Langfuse observability (optional) ===
# Traces prompts, responses and token usage for chat / embedding / rerank / VLM / ASR.
# Enabled automatically when both PUBLIC_KEY and SECRET_KEY are set. See website-docs/03-features/16-observability.md.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Performance ===
CONCURRENCY_POOL_SIZE=3

# Retention of chat attachment parsing output (hours), default 24 hours
# AIKB_CHAT_ATTACHMENT_TTL_HOURS=24

# Max time (seconds) one Q&A turn waits for attachment parsing. Attachments not finished by then are skipped.
# Raise it when large files or scans parse slowly; default 60 seconds. An agent's "Attachment Parse Wait Timeout" > 0 overrides this global value.
# AIKB_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60

# Attachment VLM OCR tuning (scans / image-based documents). The bottleneck of slow parsing is per-page VLM OCR, not the document parser.
# OCR_CONCURRENCY is the number of pages OCRed in parallel (default 8, equal to the page cap, so a scan runs in one wave; raising it loads the VLM more,
# and all agents share the VLM backend, so it stays global). OCR_MAX_PAGES is the max number of scan pages sent to the VLM (default 8).
# An agent's "Scanned OCR Max Pages" > 0 overrides this global value.
# AIKB_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# AIKB_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# Docreader address
DOCREADER_ADDR=127.0.0.1:50051

# Docreader transport
DOCREADER_TRANSPORT=grpc

# gRPC TLS settings (optional)
# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT=/path/to/server.crt           # server: required; client: set for mTLS
# GRPC_TLS_KEY=/path/to/server.key            # same as above
# GRPC_TLS_CA=/path/to/ca.crt                 # client: verifies the server cert; server: the CA that signs client certs for mTLS
# GRPC_TLS_SERVER_NAME=                       # optional; set to the cert hostname when DOCREADER_ADDR is an IP or differs from the cert CN
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false         # server side: true requires a client certificate (mTLS)

# gRPC auth token (optional; client and server must use the same value)
# Note: when GRPC_AUTH_TOKEN is enabled, enabling TLS too is strongly recommended. Otherwise the token travels
# in plaintext with every RPC. When GRPC_TLS_ENABLED=true the client refuses to send the token over an
# insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
