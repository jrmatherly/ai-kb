{
  "name": "@jrmatherly/dsh-ai-kb",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "AI KB knowledge retrieval tools for DeepSeek Harness (dsh): semantic search, document reading and RAG/agent answers over your own knowledge bases.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "aikb",
    "rag",
    "retrieval",
    "knowledge-base"
  ],
  "license": "MIT",
  "author": "AI KB",
  "homepage": "https://github.com/jrmatherly/ai-kb/tree/main/packages/dsh-ai-kb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrmatherly/ai-kb.git",
    "directory": "packages/dsh-ai-kb"
  },
  "bugs": {
    "url": "https://github.com/jrmatherly/ai-kb/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "e2e": "node test/e2e/run-in-dsh.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^6.0.3"
  }
}
