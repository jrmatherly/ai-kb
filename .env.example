# =====================================================================
# AI KB environment variable example
# ---------------------------------------------------------------------
# Usage:
#   1. Copy this file to .env: cp .env.example .env
#   2. Replace every placeholder with a real value (especially items marked REQUIRED)
#   3. Make sure .env is never committed to version control
#
# How configuration is injected:
#   - The app service reads every variable in this file via env_file: .env.
#   - The docreader / mcp / frontend / odl-hybrid services have no env_file and only
#     consume the variables listed in their own environment section (see docker-compose.yml).
#
# Group order:
#   A. Deployment basics       images, runtime, network
#   B. Data and storage        database, Redis, file storage, object storage
#   C. Retrieval and graph     vector store, knowledge graph
#   D. Models                  LLM/VLM/Ollama, built-in models
#   E. Document parsing        Docreader, task timeouts
#   F. Auth and workspaces     JWT/AES, registration, RBAC, OIDC
#   G. Agent and sandbox       Sandbox, Skills, agent timeouts
#   H. Optional integrations   web search, MCP Server
#   I. Observability           Langfuse
#   J. Security and tuning     SSRF, proxies, concurrency
# =====================================================================


# #####################################################################
# A. Deployment basics
# #####################################################################

# ========== A1. Image version and build ==========
# Image version tag: latest (stable) / main (latest development build). To pin a version, set the git tag of the target release (for example v0.7.0, note the v prefix) and run docker compose pull to fetch the matching images.
AIKB_VERSION=latest
# Debian APT mirror host for building the app image (empty uses the default source; in mainland China mirrors.tencent.com is faster).
# APK_MIRROR_ARG=
# Whether the app image build links the in-process anydoc parsing engine (default 1). Set 0 to skip the Rust toolchain and build faster; the engine then shows as unavailable on the settings page.
# WITH_ANYDOC=1
# apt mirror for the docreader image build (empty uses the default source).
# APT_MIRROR=
# Playwright browser artifact host for the docreader image build (empty uses the official CDN).
# PLAYWRIGHT_DOWNLOAD_HOST=
# Overrides only the WebKit artifact host; takes precedence over PLAYWRIGHT_DOWNLOAD_HOST when set.
# PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST=
# Short commit shown on the System Information page when the frontend image is built from source. make docker-build-frontend
# and start_all.sh --no-pull fill it from git; export it yourself for a plain docker compose build, or it shows unknown.
# VITE_FRONTEND_COMMIT=
# npm registry for the frontend image build (empty uses the default; in mainland China https://registry.npmmirror.com works).
# NPM_REGISTRY=
# Node heap limit (MB) for the Vite build. Lower it to 2048 when Docker Desktop has little memory.
# NODE_MAX_OLD_SPACE_SIZE=4096

# ========== A2. Runtime basics ==========
# Explicit path of the server config file. Empty keeps the search order (./config.yaml, ./config/config.yaml, ...).
# The Lite wrapper sets it, because the aikb CLI stores its own config.yaml in the same directory the server runs from.
# AIKB_CONFIG_FILE=
# gin mode: debug (development, verbose logs + Swagger) / release (production, Swagger disabled).
GIN_MODE=release
# Log level: debug / info / warn / error / fatal, default debug.
# LOG_LEVEL=debug
# Log file path (empty logs to stdout only); with LLM_DEBUG_LOG on, llm_debug.log goes in the same directory.
# LOG_PATH=
# Custom log format template (empty uses the built-in default).
# LOG_FORMAT=
# LLM debug log: writes the full request/response of every model call to a separate file, for debugging context issues.
# Values: true (llm_debug.log next to LOG_PATH) / false or empty (off) / a file path.
# LLM_DEBUG_LOG=true
# Time zone, default UTC. Affects displayed system time and log timestamps.
# Common values: Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC.
TZ=UTC
# System default language (BCP-47), the fallback for the {{language}} placeholder in prompts.
# Precedence: this variable > Accept-Language request header > built-in default (en-US).
# AIKB_LANGUAGE=en-US
# Default UI language for the frontend (BCP-47). The only accepted value is en-US.
# Precedence: language the user picked (localStorage) > this variable > built-in default en-US.
# Only affects first visits and users who never switched language; restart the frontend container to apply, no image rebuild.
# DEFAULT_LOCALE=en-US
# Default language fallback baked in at frontend image build (only used when the Docker runtime config.js is not used).
# VITE_DEFAULT_LOCALE=en-US
# Run database migrations at startup; set false to disable (enabled by default).
AUTO_MIGRATE=true
# Automatically recover a dirty migration state (default true).
AUTO_RECOVER_DIRTY=true
# Exit at startup when a migration fails (true or 1); by default the failure is logged and the app keeps serving.
AIKB_MIGRATE_FAIL_FAST=false
# At startup, promote the user with this email to system administrator (idempotent; only PROMOTE, never DEMOTE).
# Meant for first bootstrap on docker-compose/k8s; later grants and revocations go through the SystemAdmin page.
# AIKB_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ========== A3. Network and external addresses ==========
# App service host name, default app (the Docker internal service name); set a remote address for a remote backend.
APP_HOST=app
# Host port mapped to the app service, default 8080 (affects host access only, not container-to-container traffic).
APP_PORT=8080
# Backend port NGINX proxies to, default 8080 (the port the app container listens on).
# Keep the default for local deployments; for a remote deployment set the remote app service's real port.
# APP_BACKEND_PORT=8080
# Protocol NGINX uses to reach the backend, default http; set https when the remote backend uses HTTPS.
# APP_SCHEME=http
# Frontend service port, default 80.
FRONTEND_PORT=80
# Docreader address (used by app to reach docreader).
DOCREADER_ADDR=docreader:50051
# Docreader connection type: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# External URL of the app (affects image/file links sent to IM channels).
# Set it to a URL of this AI KB instance that the IM platform and clients can reach publicly, for example https://ai-kb.example.com.
# For IM to show knowledge base images, the IM side must fetch them over a public http URL. Pick one:
#   (A) The storage backend itself is public (object storage with a public endpoint, or MINIO_ENDPOINT set to a public host);
#      resource:// then falls back to backend presigned URLs and this variable is not needed.
#   (B) Set this variable; resource:// images are rewritten to <APP_EXTERNAL_URL>/r/<token> and served by AI KB (nginx must proxy /r/).
# With the default MinIO deployment (minio:9000 is internal), (B) is simplest; the local backend only supports (B).
# Private IPs and localhost are unreachable for IM platforms such as Feishu, WeCom and Slack; for local development use ngrok/cloudflared/frp.
# APP_EXTERNAL_URL=
# IM platforms this deployment offers (comma-separated allow-list; unset or empty means all ten, a list naming only
# unknown values means none). Channels already stored for an excluded platform stay listed but cannot start.
#   wecom       WeCom (Tencent WeChat Work) smart bot or self-built app
#   feishu      Feishu (ByteDance, China cloud)
#   lark        Lark (Feishu's international cloud, open.larksuite.com)
#   slack       Slack (Socket Mode or Events API)
#   telegram    Telegram bot (long polling or webhook)
#   dingtalk    DingTalk (Alibaba) Stream mode
#   mattermost  Mattermost outgoing webhook plus REST API
#   wechat      WeChat iLink bot (official account)
#   qqbot       QQ bot (Tencent QQ open platform)
#   yunzhijia   Yunzhijia (Kingdee)
# AIKB_IM_PLATFORMS=slack,telegram,mattermost
# Data source connector types this deployment offers (comma-separated allow-list of type identifiers such as feishu,
# notion, confluence, rss; unknown names are logged and ignored). Unset or empty offers Notion, Confluence, GitHub,
# Bitbucket, OneDrive and SharePoint only; the value all enables every connector. Excluded types leave the connector
# picker and cannot be created; existing data sources of an excluded type keep syncing. Upgrading: new data sources are
# limited to Notion, Confluence, GitHub, Bitbucket, OneDrive and SharePoint unless AIKB_DATASOURCE_TYPES lists other
# types or is all; existing sources of other types keep syncing and stay editable. Set AIKB_DATASOURCE_TYPES=all to keep
# the previous behaviour.
# AIKB_DATASOURCE_TYPES=notion,confluence,github,bitbucket,onedrive,sharepoint
# Documentation base URL the UI links to (login page, Help and docs, in-app doc links).
# AIKB_DOCS_URL=https://ai-kb.matherly.net/docs/
# Show links to the GitHub repository (login page, user menu, extension releases, migration issue report). Off by default.
# AIKB_GITHUB_LINK_ENABLED=false
# Show the Ollama section in Settings. Off by default.
# AIKB_OLLAMA_ENABLED=false
# External frontend origin, used for absolute URLs such as invitation links (empty uses host-relative URLs).
# FRONTEND_BASE_URL=
# Default form of file references in API responses: handle (default) / public.
#   handle - returns an internal resource://<handle>; the client then calls the authenticated /files proxy to fetch the image.
#   public - returns a loadable http(s) link directly; third-party apps can render it with no second request.
# A single request can override this with ?resource_urls=handle|public; see "API reference" in the README for the scope.
# public needs APP_EXTERNAL_URL above (or a publicly reachable storage backend) to build external links;
# when no link can be built the reference stays resource:// and the client can still fall back to /files.
# Note: public issues a time-limited (AI KB 2 hours / MinIO 24 hours) anonymous read link for every referenced file.
# Anonymous embed channels and API keys scoped to a knowledge base ignore this variable and always return handle.
# Also set SYSTEM_AES_KEY so grant rows are reused, direct URLs stay stable and read endpoints write less.
# RESOURCE_URL_MODE=handle
# Port of the exposed MCP Server (default 8082).
# MCP_PORT=8082


# #####################################################################
# B. Data and storage
# #####################################################################

# ========== B1. Database (REQUIRED) ==========
# Main database type: postgres / sqlite. sqlite is for Lite mode; see DB_PATH.
DB_DRIVER=postgres
# Database host.
DB_HOST=postgres
# Database port.
DB_PORT=5432
# Database user.
DB_USER=postgres
# Database password.
DB_PASSWORD=postgres123!@#
# Database name.
DB_NAME=ai_kb
# PostgreSQL sslmode: disable, allow, prefer, require, verify-ca or verify-full.
DB_SSLMODE=disable
# Used with the SQLite driver (DB_DRIVER=sqlite); ignored by the postgres driver.
# DB_PATH=./data/aikb.db

# ========== B2. Redis / streams / Asynq queue ==========
# --- Stream backend and Redis connection ---
# Stream backend: memory / redis. In redis mode the Asynq task queue also uses this Redis.
STREAM_MANAGER_TYPE=redis
# Redis address (empty disables Redis; Lite mode uses memory).
REDIS_ADDR=redis:6379
# Redis user name (Redis 6.0+ ACL, optional).
# REDIS_USERNAME=
# Redis password; leave empty if not set.
REDIS_PASSWORD=redis123!@#
# Redis database index, default 0.
REDIS_DB=0
# Redis key prefix for namespace isolation.
REDIS_PREFIX=stream:
# Redis channel namespace suffix (isolates deployments that share one Redis).
# AIKB_REDIS_NAMESPACE=
# Asynq client Redis read/write timeout (ms, default 500; writes can extend to 1000).
# AIKB_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS (encrypted transport for managed Redis such as AWS ElastiCache; off by default) ---
# Whether to enable TLS.
# REDIS_USE_TLS=false
# Server name for TLS certificate verification and SNI (useful when the address is an IP).
# REDIS_TLS_SERVER_NAME=
# Skip server certificate verification. Insecure: development/self-signed certs only, never in production.
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker concurrency ---
# Each pool is a separate asynq.Server, hard isolated; empty or <1 uses the code default. Values are the guaranteed concurrency per instance and add up across replicas. They can also be changed at runtime in System Settings (asynq.*_concurrency) without a restart. Format: variable = default - queues consumed / notes
# default + chat_attachment (main document parsing path; chat_attachment has higher weight so bulk imports do not crowd it out)
# AIKB_ASYNQ_CORE_CONCURRENCY=8
# postprocess (knowledge base post-processing/fan-out after parsing; its own pool so it does not wait behind long DocReader jobs, needs low latency)
# AIKB_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question (summaries, image multimodal, graph chunk extraction, question generation; LLM/VLM heavy, tune to provider budget)
# AIKB_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low (data source sync, FAQ import, KB clone/delete, bulk reparse, knowledge moves; long-running, not part of shared borrowing)
# AIKB_ASYNQ_MAINTENANCE_CONCURRENCY=4
# Elastic pool that can borrow CORE/ENRICHMENT queues (atomic dequeue is safe); does not consume POSTPROCESS/MAINTENANCE
# AIKB_ASYNQ_SHARED_CONCURRENCY=6
# Dedicated pool for wiki generation (LLM-bound, tune to provider concurrency budget)
# AIKB_WIKI_ASYNQ_CONCURRENCY=8
# Per-model concurrency cap for background tasks (0/negative disables; interactive chat is not limited)
# AIKB_MODEL_MAX_CONCURRENCY=32

# ========== B3. File storage (general) ==========
# File storage type: local / minio / cos / tos / s3 / obs / oss / dummy.
STORAGE_TYPE=local
# Allowlist of storage types users may use (comma-separated, empty allows all).
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3,obs,oss
# Local storage root directory (used when STORAGE_TYPE=local).
LOCAL_STORAGE_BASE_DIR=/data/files
# Local storage path prefix (for legacy backfill, usually empty).
# LOCAL_STORAGE_PATH_PREFIX=
# Unified file size limit (MB, default 50). Applies to knowledge base/attachment single-file uploads, docreader gRPC messages and browser knowledge base checks. Deploy-time setting: Go/Nginx/docreader/browser each read it once at startup, changes do not apply at runtime, and all four must be restarted after a change.
# MAX_FILE_SIZE_MB=50
# Limit (MB, default 256) for skill zip uploads and GitHub/ClawHub source downloads. Separate from knowledge base uploads: skill bundles such as ppt-master exceed 50MB. A GitHub zipball counts as the whole-repo archive, not the SKILL.md subtree; an oversized repo is still rejected at download. When unset it is at least MAX_FILE_SIZE_MB and at most 512. Nginx raises only POST /api/v1/skills/catalog and POST /api/v1/sandbox-configs/{id}/skills to this value; subpaths such as /install and PATCH still use MAX_FILE_SIZE_MB. Restart app and frontend after a change.
# MAX_SKILL_BUNDLE_SIZE_MB=256

# ========== B4. Object storage provider (pick one by STORAGE_TYPE) ==========
# ----- MinIO (STORAGE_TYPE=minio) -----
# MinIO endpoint (host:port). With IM channels it must be a host the IM platform can reach publicly (not minio:9000).
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO ports (for compose mapping).
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- Tencent Cloud COS (STORAGE_TYPE=cos) -----
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET_NAME=your_cos_bucket_name
# COS_APP_ID=your_cos_app_id
# COS_PATH_PREFIX=your_cos_path_prefix
# COS_TEMP_BUCKET_NAME=your_cos_temp_bucket_name
# COS_TEMP_REGION=your_cos_temp_region
# ----- Volcengine TOS (STORAGE_TYPE=tos) -----
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=your_tos_access_key
# TOS_SECRET_KEY=your_tos_secret_key
# TOS_BUCKET_NAME=your_tos_bucket_name
# TOS_PATH_PREFIX=your_tos_path_prefix
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name
# TOS_TEMP_REGION=your_tos_temp_region
# To use AWS S3 for file storage, set the following
# AWS S3 endpoint (optional; empty uses the standard AWS endpoint for the region, for example https://s3.amazonaws.com)
# ----- AWS S3 (STORAGE_TYPE=s3) -----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS S3 Access Key (optional; when AK and SK are both empty the AWS SDK default credential chain is used,
# supporting EC2/ECS/EKS IAM Role, IRSA/Web Identity, environment variables and shared config files)
# AWS S3 Secret Key (set together with the Access Key, or leave both empty)
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=aikb/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false
# ----- Huawei Cloud OBS (STORAGE_TYPE=obs) -----
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_REGION=cn-north-4
# OBS_ACCESS_KEY=your_obs_access_key
# OBS_SECRET_KEY=your_obs_secret_key
# OBS_BUCKET_NAME=your_obs_bucket_name
# OBS_PATH_PREFIX=aikb/
# OBS_USE_SSL=true
# OBS_PROXY_DOMAIN=https://your-domain.com/obs
# ----- Alibaba Cloud OSS (STORAGE_TYPE=oss) -----
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET_NAME=your_oss_bucket_name
# OSS_PATH_PREFIX=aikb/
# OSS_TEMP_BUCKET_NAME=your_oss_temp_bucket_name
# OSS_TEMP_REGION=your_oss_temp_region
# ----- Kingsoft Cloud KS3 (STORAGE_TYPE=ks3) -----
# KS3_ENDPOINT=https://ks3-cn-beijing.ksyuncs.com
# KS3_REGION=cn-beijing
# KS3_ACCESS_KEY=your_ks3_access_key
# KS3_SECRET_KEY=your_ks3_secret_key
# KS3_BUCKET_NAME=your_ks3_bucket_name
# KS3_PATH_PREFIX=aikb/


# #####################################################################
# C. Retrieval and graph
# #####################################################################

# ========== C1. Vector store / retrieval engine ==========
# Vector store type (comma-separated for several drivers): postgres / elasticsearch_v7 / elasticsearch_v8 /
# opensearch / qdrant / milvus / weaviate / doris / tencent_vectordb.
RETRIEVE_DRIVER=postgres
# Timeout for parallel retrieval across vector stores (seconds, applies when RETRIEVE_DRIVER lists several drivers).
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=ai_kb
# ----- OpenSearch (the dev compose ships a single-node profile) -----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=ai_kb
# The opensearch-go client polls GET /_nodes/_local/stats every few seconds per client; -1 turns that off.
# OPENSEARCH_GO_NODE_STATS_INTERVAL=-1
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=aikb_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=aikb_embeddings
# MILVUS_METRIC_TYPE=IP          # IP (default)/COSINE/L2; changing it requires rebuilding the collection.
# New collections configure english/chinese/default multilingual analyzers for content;
# for an old collection first run go run ./cmd/milvus-migrate (the metric is kept from the source collection),
# then change MILVUS_COLLECTION to the target prefix. Do not change MILVUS_METRIC_TYPE.
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# Inside containers use service:port (not localhost or the host-mapped port).
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # Set true and configure WEAVIATE_API_KEY when using APIKey/OIDC.
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name
# ----- Apache Doris 4.1+ -----
# DORIS_ADDR=doris-fe:9030       # FE MySQL protocol address.
# DORIS_HTTP_PORT=8030           # FE HTTP, Stream Load partial updates in legacy compat mode only.
# DORIS_DATABASE=aikb
# DORIS_USERNAME=root
# DORIS_PASSWORD=
# DORIS_TABLE_PREFIX=aikb_embeddings
# DORIS_COMPAT_MODE=auto         # auto (probe)/legacy (cosine_distance)/inner_product_duplicate; not interchangeable after tables exist.
# compose ports.
# DORIS_FE_HTTP_PORT=8030
# DORIS_FE_MYSQL_PORT=9030
# DORIS_BE_HTTP_PORT=8040
# ----- Tencent Cloud Tencent VectorDB -----
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com
# TENCENT_VECTORDB_USERNAME=root
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key
# TENCENT_VECTORDB_DATABASE=aikb
# TENCENT_VECTORDB_COLLECTION=aikb_embeddings
# TENCENT_VECTORDB_REPLICA_NUMBER=1

# ========== C2. Knowledge graph (Neo4j, optional) ==========
# The single global switch for the knowledge graph. Anything but true disables graph building and retrieval (building calls an LLM and takes a while).
# Note: ENABLE_GRAPH_RAG was replaced by NEO4J_ENABLE in v0.1.6; the Go app no longer reads it and it was removed.
# NEO4J_ENABLE=false
# Neo4j connection URI. bolt:// connects directly to a single instance (recommended, no routing overhead); neo4j:// uses cluster routing discovery (works on a single instance but adds a probe).
# AI KB deploys a single Neo4j instance by default, so it uses bolt://.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. Models
# #####################################################################

# ========== D1. LLM / VLM / Ollama ==========
# When Ollama is unavailable, only warn instead of blocking (applies when true; the default does not block, so startup does not fail without Ollama).
OLLAMA_OPTIONAL=true
# The single address of the local Ollama. Embedding and chat models with source=local share this process,
# so no second Ollama is needed for embeddings. When unset the process falls back to http://localhost:11434.
# The embedding model name is not an env variable: in "Settings -> Models", the CLI or the initialization API, set the Embedding
# model's name to the Ollama model name (for example nomic-embed-text). See the Ollama notes in the README.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding batch size (empty uses the code default).
# BATCH_EMBED_SIZE=
# Timeout for one VLM HTTP request (seconds, default 180; raise it when a slow endpoint reports context deadline).
# VLM_HTTP_TIMEOUT_SECONDS=180
# Raw dump of LLM streams (for debugging context issues; 1 enables, default directory ~/.aikb/investigate/llm-stream).
# AIKB_LLM_STREAM_RAW_DUMP=
# AIKB_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. Declarative built-in models (optional) ==========
# Once config/builtin_models.yaml is enabled (see config/builtin_models.yaml.example), its
# ${NAME} placeholders are read from here at app startup. The YAML defines the names; common ones are listed below.
# See website-docs/03-features/06-models.md.
#
# Built-in chat model
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# Built-in embedding model. These names are read only when builtin_models.yaml references them as ${...}.
# A local Ollama embedding model uses source: local with name ${EMBEDDING_MODEL_NAME} (the Ollama model name);
# the address is still OLLAMA_BASE_URL above. EMBEDDING_BASE_URL is only for source: remote APIs.
# See the "one local Ollama" section of config/builtin_models.yaml.example.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Built-in rerank model
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. Document parsing
# #####################################################################

# ========== E1. Docreader gRPC and general parsing ==========
# ----- gRPC server TLS / auth (shared by docreader and app; client and server need the same values) -----
# Enable gRPC TLS. Default false (docreader only serves app inside the compose network, plaintext is fine).
# GRPC_TLS_ENABLED=false
# Server certificate / client certificate (set for mTLS). Required when the server enables TLS.
# GRPC_TLS_CERT=/path/to/server.crt
# Private key for the certificate.
# GRPC_TLS_KEY=/path/to/server.key
# CA certificate: the client uses it to verify the server cert; for server-side mTLS it is the CA that signs client certs.
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / certificate verification name. Set it to the hostname in the cert when DOCREADER_ADDR is an IP or differs from the cert CN.
# GRPC_TLS_SERVER_NAME=
# Server side: true requires clients to present a certificate (mutual TLS / mTLS).
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# gRPC per-RPC auth token (client and server must match). When enabled, also enabling TLS is strongly recommended;
# otherwise the token travels in plaintext with every RPC. With GRPC_TLS_ENABLED=true the client refuses to send the token over an insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC service parameters -----
# Max concurrent gRPC server workers (default 4).
# DOCREADER_GRPC_MAX_WORKERS=4
# gRPC single message size limit (MB, default 50). Usually follows MAX_FILE_SIZE_MB; images from large scans may exceed it.
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC listen port (default 50051). Usually unchanged; must match the docreader port in docker-compose.
# DOCREADER_GRPC_PORT=50051
# ----- General parsing -----
# Max pages for DOCX parsing (default 0 = no limit). A positive integer (such as 500) caps the cost of very large Word documents.
# DOCREADER_DOCX_MAX_PAGES=0
# Concurrent workers for MarkItDown (heavy parser). 0 disables the limit; the default 1 suits a single machine or limited GPU.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# Outbound HTTP/HTTPS proxy (for fetching web pages / remote images).
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=
# AI KB Cloud (upstream WeKnoraCloud) is a client for a hosted parser and model service in Tencent's cloud: documents sent
# through it leave your deployment. Off by default: the parser engine reports "disabled by this deployment", the Settings entry
# and the model provider are hidden, and its credential routes answer 400. Set true only if you hold WeKnoraCloud credentials.
# AIKB_WEKNORACLOUD_ENABLED=false

# ========== E2. OpenDataLoader hybrid (optional, when knowledge base parser_engine_rules set engine: opendataloader) ==========
# ODL heavy parser concurrency (default 1).
# DOCREADER_ODL_MAX_WORKERS=1
# Hybrid mode switch: off (default, local fast parsing only) / docling-fast and others (need a separate odl-hybrid container).
# DOCREADER_ODL_HYBRID=off
# odl-hybrid service address. Code default http://127.0.0.1:5002; docker compose injects http://odl-hybrid:5002.
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# Hybrid mode selection (auto), usually unchanged.
# DOCREADER_ODL_HYBRID_MODE=auto
# Whether to fall back to fast mode when hybrid fails (default false).
# DOCREADER_ODL_HYBRID_FALLBACK=false
# Whether hybrid markdown output keeps HTML (default false).
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid container parameters (only with --profile odl-hybrid) -----
# Extra arguments for odl-hybrid. Default --no-ocr (digital PDFs); for scans use --force-ocr (needs EasyOCR+libGL).
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# odl-hybrid external port (for dev compose mapping).
# ODL_HYBRID_PORT=5002
# Max time (seconds) app waits at startup for odl-hybrid to be ready.
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF rendering ==========
# PDF render workers (concurrency across documents, default 1).
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# Parallel processes for rendering scanned pages within one PDF (pdfium is not thread-safe, so it parallelizes by process). Default min(4, cpu). Rendering a large scan serially in a CPU-limited container can take hours; raising this cuts it a lot (measured on 874 pages: 117s -> 30s with 4 processes -> 17s with 8). The container needs enough CPU to benefit.
# DOCREADER_PDF_RENDER_PARALLELISM=4
# Render DPI (default 200).
# DOCREADER_PDF_RENDER_DPI=200
# JPEG quality of rendered images (default 85).
# DOCREADER_PDF_JPEG_QUALITY=85
# Max long-edge pixels of a rendered page image (default 2000). Keeps huge pages from producing 100+MP images that exceed the gRPC message limit; lower it to shrink images further, but too low hurts OCR (for dense Chinese text keep >=1600).
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. PDF scan detection and forcing ==========
# Parse every PDF page as a scan (render to image, then OCR/VLM). Suits PDFs with a poor text layer but OCR-able pages; speed and model cost both go up. Default false (decided by the thresholds below).
# DOCREADER_PDF_FORCE_SCANNED=false
# Auto detection: a page whose image objects cover >= this ratio of its area counts as scanned (default 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# Auto detection: a page with fewer text characters than this has "no usable text layer" (default 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF layout / text extraction (native text pages) ==========
# Layout-aware text extraction: rebuilds a readable reading order (default true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# When glyphs have no explicit space (common in OCR/searchable text), insert a space when the gap exceeds this multiple of the median char width (default 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# Page-width ratio below which narrow margin columns (arXiv side watermarks, page labels) are dropped (default 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# Minimum characters in a line before the font-size heuristic may promote it to a markdown heading (default 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# Promote visually larger lines to markdown headings (rect height as a font-size proxy, default true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# Drop invisible text (render-mode 3), off-page text and degenerate text, guarding against hidden-text injection (default true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# Clean pdfium placeholders (U+FFFE) and soft hyphens; strip axis/legend text of vector charts (default true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# Strip text fragments in chart areas (works with SANITIZE_TEXT, default true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. PDF embedded image extraction (native text pages) ==========
# Extract embedded bitmaps from native pages for VLM/OCR analysis (default true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# Minimum pixel width and height kept for embedded images (default 80; smaller ones are dropped).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# Minimum share of page area for an embedded image; smaller ones are dropped (default 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# When the same image appears on >= this fraction of text pages it is treated as a running header/footer and deduplicated (default 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# Hard cap on embedded images extracted per document (default 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. PDF chart region detection (vector figure areas) ==========
# Render detected vector chart regions (no embedded bitmap) to JPEG for VLM/OCR (default true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# Minimum characters per line for a region to count as a chart (default 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# Minimum area share for a region to count as a chart (default 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# Maximum area share for a region to count as a chart (larger is not a chart, default 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# Maximum figure height as a share of page height; taller is not treated as a standalone chart (default 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. Document processing / task timeouts ==========
# Overall timeout of one document processing task (Go duration, default 2h; raise for large files).
# AIKB_DOCUMENT_PROCESS_TIMEOUT=2h
# Timeout of one DocReader RPC (default 30m; must be less than the item above).
# AIKB_DOCREADER_CALL_TIMEOUT=30m
# HTTP request timeout for self-hosted PaddleOCR-VL (positive Go duration, default 1000s; invalid values fall back to the default).
# Large-file example: this item 90m, DocReader 100m, document task 2h; outer timeouts need headroom.
# AIKB_PADDLEOCR_VL_TIMEOUT=1000s
# Timeout of one self-hosted MinerU parse (positive Go duration, default 1000s; invalid values fall back to the default).
# Very large PDFs also need outer headroom, for example this item 90m, DocReader 100m, document task 2h.
# AIKB_MINERU_TIMEOUT=1000s
# Max time to poll MinerU cloud (mineru.net) for parse results (positive Go duration, default 600s).
# AIKB_MINERU_CLOUD_TIMEOUT=600s
# Max time to poll PaddleOCR-VL cloud (AI Studio) for parse results (positive Go duration, default 600s).
# AIKB_PADDLEOCR_VL_CLOUD_TIMEOUT=600s
# Max time to poll WeKnoraCloud managed docreader for task results (positive Go duration, default 20m; should be less than AIKB_DOCREADER_CALL_TIMEOUT).
# AIKB_WEKNORACLOUD_TIMEOUT=20m
# Knowledge base housekeeping (reclaims stale items stuck in processing; false disables it, not recommended).
# AIKB_HOUSEKEEPING_ENABLED=true
# Retention of chat attachment parsing output (hours, default 24).
# AIKB_CHAT_ATTACHMENT_TTL_HOURS=24
# Max time (seconds) one Q&A turn waits for attachment parsing (default 60; raise for large files or scans).
# AIKB_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# Attachment VLM OCR tuning (scans/image-based documents): concurrency / max pages.
# AIKB_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# AIKB_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# ========== E9. Feishu cloud document parsing mode ==========
# Controls how new Feishu cloud documents (docx) are parsed when syncing Feishu Drive / Feishu Wiki:
#   export (default, leave empty): downloads the .docx binary through the async export API and hands it to docreader
#     for parsing. Images are inlined into the parent document (linked to the knowledge item via parent_chunk_id), so retrieval /
#     wiki / agents can all link image content. Cost: slower sync; file block attachments inside Feishu docx
#     are not downloaded with the export (they are lost and must be synced separately); spreadsheets and
#     Bitable tables in the cloud document become tables embedded in the docx after export, and AI KB cannot parse those tables.
#   blocks: converts through the blocks API to Markdown. Fast and keeps attachments in the docx, but images render as empty
#     `![...]()` placeholders (Chinese alt text) and are imported as separate knowledge items with no content link to the parent document (retrieval /
#     wiki / agents cannot link images back to the document); spreadsheets parse to markdown tables,
#     with a risk of losing styles such as merged cells.
# Set to blocks when you do not need image links, want speed, need to keep attachments or need spreadsheet styles.
# This is a temporary solution; if a better parsing approach appears, this env variable will be removed and replaced.
# FEISHU_DOCX_PARSE_MODE=export

# Feishu export create / query / download and Wiki child-node listing each use a per-app shared quota (single process).
# Default 80 requests/minute per endpoint, sent smoothly with no burst accumulation; a positive integer overrides the default.
# FEISHU_API_REQUESTS_PER_MINUTE=80
# Wait time when a rate-limit response has no usable wait hint (Go duration, default 10s).
# FEISHU_RATE_LIMIT_RETRY_WAIT=10s
# Max wait per shared cooldown, including response header hints and the default wait above (Go duration).
# FEISHU_RATE_LIMIT_MAX_WAIT=5m
# Max polls for an export task; rate-limit retries and queueing do not count, and the task context can still cancel.
# FEISHU_EXPORT_MAX_POLLS=30
# Interval between two polls of an export task (Go duration).
# FEISHU_EXPORT_POLL_INTERVAL=2s

# #####################################################################
# F. Auth and workspace isolation
# #####################################################################

# ========== F1. Keys (REQUIRED; replace the defaults before storing real credentials) ==========
# The server refuses to start when JWT_SECRET is empty or SYSTEM_AES_KEY is not exactly 32 bytes. The values below are
# the shipped defaults: they let a first start work and the server warns about each one until it is replaced.
# JWT signing key for login tokens. Generate once: openssl rand -hex 32
# The shipped default is never used to sign: the server generates a per-install secret, stores it in the database and
# uses that instead, so it cannot be used to forge tokens.
JWT_SECRET=aikb-default-jwt-secret-change-me
# AES-256 master key for encrypting sensitive fields such as API keys at rest in the database (must be 32 bytes).
# Encrypted fields: tenants.api_key, model API keys, vector store credentials, web search provider keys,
# WeKnoraCloud.AppSecret and more. Values encrypted under one key cannot be read under another (the UI shows them
# empty and they must be re-entered), so replace the shipped default before storing real credentials and keep the key.
# Losing it makes all encrypted data unrecoverable.
# Note: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT are deprecated. CryptoService (PBKDF2) was removed in v0.4.0 and encryption now uses SYSTEM_AES_KEY only. The Go app no longer reads these three variables and they were removed.
# Generate once: openssl rand -hex 16 (32 ASCII bytes); retain existing keys on upgrade.
SYSTEM_AES_KEY=aikb-default-aes-key-change-me!!
# Optional independent signing key for embed sessions and presigned URLs.
# Generate once: openssl rand -hex 32. Falls back to SYSTEM_AES_KEY unless that is the shipped default, so with the
# defaults embed sessions and presigned file links stay disabled until one of the two is set.
SYSTEM_SIGNING_KEY=

# ========== F2. Registration and workspace policy ==========
# Disable new user registration (true recommended in production).
# DISABLE_REGISTRATION=false
# When on, passwords must contain upper and lower case letters, digits and special characters. Special characters: !@#$%^&*()_+-=[]{}|;:,.<>?
# AIKB_AUTH_COMPLEX_PASSWORD_ENABLED=false
# Default workspace policy after public registration: create_personal (default, creates a personal workspace) / tenantless.
# AIKB_AUTH_DEFAULT_TENANT_MODE=create_personal
# Whether regular users may create workspaces after login (default true; false means join by invitation only, super admins unaffected).
# AIKB_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# Enable workspace-level RBAC (true, the default, enforces it / false is observe mode: role checks inside a workspace are logged, not blocked; cross-workspace access is always blocked).
# AIKB_TENANT_ENABLE_RBAC=true
# Enable cross-workspace access (requires the user's CanAccessAllTenants permission; default false). A cross-workspace admin needs a manual database change granting that user cross-workspace admin rights
# AIKB_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
# Max workspaces one non-super-admin user can create (>0 enforces the cap; =0 uses the default; <0 disables the cap).
# AIKB_TENANT_MAX_OWNED_PER_USER=
# Whether creating a workspace auto-generates a full_access API key and returns its token in the response (default false; legacy fallback switch).
# AIKB_TENANT_AUTO_CREATE_API_KEY=false
# Default storage quota for new workspaces (GB, default 10).
# AIKB_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# Workspace invitation link TTL (Go duration, default 168h = 7 days).
# AIKB_INVITATION_TTL=168h
# Global switch: invited registered users join the workspace directly. Default false; can be changed in System Settings.
# AIKB_TENANT_AUTO_ACCEPT_INVITATION=false
# Audit log retention in days (0 disables cleanup, default 90).
# AIKB_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC auth (optional, enabled by OIDC_AUTH_ENABLE=true) ==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# When OIDC_AUTH_DISCOVERY_URL is set, the endpoints below can be empty. Even with explicit authorization/token endpoints,
# discovery still fills in jwks_uri or issuer when either is empty, for id_token validation.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_JWKS_URI=http://127.0.0.1:5556/dex/keys
# Add groups when the group mapping below is used (the claim arrives only with that scope).
# OIDC_AUTH_SCOPES="openid profile email"
# Exact return URLs the browser extension may pass as return_to to /auth/oidc/start (comma-separated; empty disables it).
# Each store assigns its own extension ID: list the Chrome one, the Edge one, and the dev build's.
# OIDC_AUTH_EXTENSION_RETURN_URLS=https://<chrome-extension-id>.chromiumapp.org/oidc,https://<edge-extension-id>.chromiumapp.org/oidc
# The workspace policy for first-time OIDC auto-provisioning shares AIKB_AUTH_DEFAULT_TENANT_MODE with local registration; there is no separate setting.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email
# Groups to roles (system settings oidc.groups_claim, oidc.system_admin_groups and oidc.group_role_map take precedence).
# Entries are group:workspace:role, comma-separated; workspace is a slug or a numeric id. Off while both lists are empty.
# OIDC_AUTH_GROUPS_CLAIM=groups
# OIDC_AUTH_SYSTEM_ADMIN_GROUPS=
# OIDC_AUTH_GROUP_ROLE_MAP=


# #####################################################################
# G. Agent and sandbox
# #####################################################################

# ========== G1. Agent Skills Sandbox ==========
# Sandbox backend, credentials, templates, timeouts and private network access policy are all managed per workspace
# in "Settings -> Sandbox backend". The only deployment-level switch is the Docker backend: off by default, because the local
# docker.sock equals host root; for single-host self-hosting set it to true, or a system administrator can turn it on in
# "Settings -> System Settings -> Network Security" (takes effect immediately, no restart).
AIKB_SANDBOX_DOCKER_ENABLED=false
# Multiple instances should still set the shared REDIS_ADDR to share the session->sandbox binding.

# Default timeout for agent LLM calls (seconds, default 120; raise for complex reasoning, such as 300/600).
# Note: global default; an agent with its own llm_call_timeout in the database uses that instead.
# AIKB_AGENT_LLM_TIMEOUT=300
# Wait timeout for manual approval of MCP tools (seconds, default 600; Go durations such as 30s/5m/1h also work).
# AIKB_AGENT_TOOL_APPROVAL_TIMEOUT=600
# Whether to allow the call when MCP tool manual approval fails (true allows / default fail-close denies).
# AIKB_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. Optional integrations
# #####################################################################

# ========== H1. Web search (SearXNG / Tavily) ==========
# ===== SearXNG (optional self-hosted web search) =====
# Enable: `docker compose --profile searxng up -d`.
# When SEARXNG_SECRET is unset, the hard-coded default in docker-compose is used, which is enough for local/loopback deployments;
# if you set SEARXNG_BIND=0.0.0.0 to expose the instance to the LAN/internet, generate one with openssl rand -hex 32
# and set SEARXNG_SECRET explicitly, or anyone can use the default to sign image-proxy URLs.
#
# Backend access (containerized deployment): in the console pick Provider type "SearXNG",
# Instance URL http://searxng:8080; docker compose already injects the searxng host name into
# SSRF_WHITELIST_EXTRA, no extra setup.
#
# Local development (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# the backend runs on the host and must use the published port; set Instance URL to http://127.0.0.1:8888,
# and add 127.0.0.1 to SSRF_WHITELIST below (make dev-app adds it to SSRF_WHITELIST_EXTRA for you).
#
# The port listens on 127.0.0.1 only by default, so an instance with limiter:false is not exposed to the LAN.
# To open it to the internal network, override SEARXNG_BIND=0.0.0.0 explicitly and harden it yourself.
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first - POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API key (optional, enables the Tavily web search provider).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP Server (optional, starts with --profile full) ==========
# API key the MCP Server uses for the AI KB REST API (generate it in the frontend under "Settings -> API Keys").
# AIKB_API_KEY=
# Required for HTTP/SSE transport: mcp-server refuses to start without it (clients send it as Authorization: Bearer).
# MCP_SERVER_AUTH_TOKEN=
# Read timeout for calls to the AI KB REST API (seconds, default 300).
# AIKB_CHAT_TIMEOUT=300
# Whether to verify the AI KB backend TLS certificate (default true; set false for self-signed certs).
# AIKB_VERIFY_SSL=true
# Allowlist of directories allowed for upload (comma-separated; empty disables the file upload tool).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. Observability (Langfuse, optional)
# #####################################################################

# ========== I1. Langfuse (traces chat/embedding/rerank/VLM/ASR model calls and token usage) ==========
# Details: website-docs/03-features/16-observability.md
#
# Option A: Langfuse Cloud (simplest)
#   1) Sign in at https://cloud.langfuse.com and create an API key
#   2) Uncomment PUBLIC_KEY / SECRET_KEY below and fill them in
#   3) docker compose up -d app
#
# Option B: self-hosted Langfuse (LAN/internal network)
#   1) Start the self-hosted stack: docker compose --profile langfuse up -d
#      After first start the ClickHouse migration takes about 1-2 minutes; wait for langfuse-web to be healthy
#   2) Open http://localhost:3000, register an admin account and create an API key
#   3) Uncomment LANGFUSE_HOST=http://langfuse-web:3000 below and fill in the new PUBLIC_KEY / SECRET_KEY
#   4) docker compose up -d app
#
# Setting both PUBLIC_KEY + SECRET_KEY enables it automatically; no explicit switch is needed.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=http://langfuse-web:3000
# Optional: explicit switch (true/false; by default decided from the keys).
# LANGFUSE_ENABLED=true
# Optional: release / environment tags for filtering in the Langfuse UI.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# Optional: batching and sampling (for high production traffic raise FLUSH_AT and lower SAMPLE_RATE).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Self-hosted Langfuse stack (only needed with --profile langfuse) ==========
# Design: to minimize resource use, the self-hosted Langfuse stack **reuses** existing AI KB services
#   - postgres: a separate "langfuse" database (created once by the langfuse-db-init container)
#   - redis   : a separate Redis DB number (default 1; AI KB uses 0)
# The only new long-running containers are 3: langfuse-web, langfuse-worker, langfuse-clickhouse
#                         + 1 dedicated S3: langfuse-minio
#                         + 1 one-off init: langfuse-db-init
# Langfuse Web UI external port.
# LANGFUSE_WEB_PORT=3000
# Ports of the Langfuse MinIO (avoids clashing with the main AI KB MinIO on 9000/9001).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# External endpoint for media uploads (the browser talks to Langfuse MinIO directly), defaults to host-mapped port 9100.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# Name of the Langfuse database created in ai-kb-postgres.
# LANGFUSE_DB_NAME=langfuse
# DB number used in ai-kb-redis (1~15; must not clash with AI KB's 0).
# LANGFUSE_REDIS_DB=1
# ClickHouse / Langfuse MinIO credentials (always change in production).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
# Langfuse core security fields; regenerate them for production:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
# Optional: automate first start (when set, the admin and project are injected directly, skipping UI registration).
# LANGFUSE_INIT_ORG_ID=ai-kb
# LANGFUSE_INIT_ORG_NAME=AI KB
# LANGFUSE_INIT_PROJECT_ID=ai-kb
# LANGFUSE_INIT_PROJECT_NAME=AI KB
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-ai-kb-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-ai-kb-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
# J. Security and deployment tuning
# #####################################################################

# ========== J1. SSRF protection ==========
# SSRF check allowlist (optional). Comma-separated; each entry can be an exact domain (api.internal), a wildcard domain (*.example.com),
# IPv4 (203.0.113.5), IPv6 (2001:db8::1, no brackets) or CIDR (10.0.0.0/8, 2001:db8::/32).
# Listed entries bypass the normal SSRF rules in URL checks and elsewhere; configure carefully in production.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# Allowlist-only outbound (off by default). When true the allowlist is the entire outbound policy: hosts not in SSRF_WHITELIST /
# SSRF_WHITELIST_EXTRA (including direct IPs) are rejected before any DNS lookup, and domains match by name only,
# no longer by resolved CIDR. Recommended for offline or internal deployments, with every model, vector store and object storage address allowlisted.
# SSRF_DNS_WHITELIST_ONLY=false
#
# Outbound dial timeout (Go duration, default 5s): external endpoints such as models and connectors fail if not connected in time.
# Raise it for serverless endpoints with slow cold starts, for example 15s.
# AIKB_OUTBOUND_DIAL_TIMEOUT=5s
#
# ===== SSRF checks on vector store addresses =====
# When a vector store connection is created/tested via the API, its address goes through the SSRF check. The docker-compose built-in services
# (qdrant, milvus, weaviate, doris-fe, doris-be, searxng, minio) are allowed by default through SSRF_WHITELIST_EXTRA.
# For external private addresses or blocked ports (5432, 9200 and so on), add the host to SSRF_WHITELIST_EXTRA
# (note: setting this variable overrides the compose default, so include the built-in service names again), for example:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,minio,my-opensearch.internal
#
# Doris Stream Load (legacy compat mode only): FE answers with a 307 redirect to BE; docker compose allows
# doris-fe and doris-be by default (see SSRF_WHITELIST_EXTRA).
#
# Local development (go run + docker-compose.dev.yml --profile opensearch): the backend runs on the host,
# reaching OpenSearch through the published port http://localhost:9200; before creating that vector store via the API,
# add localhost to SSRF_WHITELIST (9200 is a blocked port, localhost a restricted host name):
#   SSRF_WHITELIST=localhost
# Image host allowlist whose original URLs are kept (optional, comma-separated). Images from these hosts are still downloaded for analysis
# (OCR/captions), but markdown keeps the original URL instead of the object storage provider:// URL.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. Proxies and concurrency ==========
# Proxy CIDRs gin trusts (comma-separated). Default trusts loopback + private ranges (covers nginx inside the container network).
# An explicit empty string disables proxy trust (ClientIP returns the direct peer). Behind several proxy layers in production, set the real values.
# AIKB_TRUSTED_PROXIES=
# ants goroutine pool size (embedding concurrency; lower it on 429 errors).
CONCURRENCY_POOL_SIZE=5

# ========== J3. BrowserSkill Local Browser (optional) ==========
# Users connect through the Chrome extension; for deployment and limits see website-docs/05-clients/09-local-browser.md.
# The Docker app image bundles bsk and its extension and builds the connection URL from the user's current page by default, so PUBLIC_URL is not needed.
# A native deployment also needs the build outputs and the two file paths below; an explicit empty BROWSERSKILL_BINARY= turns the feature off.
# Absolute path to the official bsk executable for the backend's OS/architecture (preset in Docker, no need to repeat).
# BROWSERSKILL_BINARY=/opt/ai-kb/browserskill/bsk
# Optional override: set only for special deployments where the gateway uses its own domain/path; remote deployments must use WSS (internal networks included).
# BROWSERSKILL_PUBLIC_URL=wss://ai-kb.example.com/api/v1/local-browser/extension
# One app instance shares one daemon; max user pairing records kept (default 32, not a measured capacity).
# BROWSERSKILL_MAX_CONNECTIONS=32
# Companion extension ZIP offered for download in personal settings (absolute local path on the server, preset in Docker).
# BROWSERSKILL_EXTENSION_PATH=/opt/ai-kb/browserskill/browser-skill-ai-kb-0.3.1.zip
# Multiple replicas: each node sets an address other nodes can reach directly, not the load balancer address.
# BROWSERSKILL_INTERNAL_URL=http://10.0.0.12:8080
# All replicas use the same random key (at least 32 characters), injected from a Secret, never committed to the repo.
# BROWSERSKILL_CLUSTER_SECRET=
